# Vayl deployment config — copy to `.env` and edit.
#   from source:   docker compose up -d --build
#   from image:    docker compose -f docker-compose.client.yml up -d   (clients — see DISTRIBUTION.md)
# Only the LLM block is REQUIRED. Everything else has a safe default or is optional.
# Full walkthrough: DEPLOY.md

# Image to run (clients only; pin a version for deliberate upgrades):
# VAYL_IMAGE=ghcr.io/vayl-dev/vayl:0.1.0

# ─────────────────────────────────────────────────────────────────────────────
# 1) LLM  (REQUIRED — Vayl does nothing without a model)
# Pick ONE path.

# LLM_PROVIDER is one of: openai (any OpenAI-compatible endpoint, incl. Ollama/vLLM), anthropic, groq.
# Path A — point at your existing OpenAI-compatible endpoint (recommended for prod):
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1        # or your Azure OpenAI / EU-hosted / vLLM endpoint
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-5-mini                          # the default; gpt-5-nano is cheaper but weaker on messy corrections
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-REPLACE_ME
EMBED_MODEL=text-embedding-3-small

# Path B — self-hosted or region-pinned inference (vLLM, Azure OpenAI, an EU endpoint).
# Same variables, different base URLs; model names are whatever that endpoint serves.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=your-model
# EMBED_BASE_URL=https://your-endpoint/v1
# EMBED_API_KEY=your-key
# EMBED_MODEL=your-embedding-model

# ─────────────────────────────────────────────────────────────────────────────
# 2) Storage  (default: SQLite on the vayl-data volume — fine for a single node)
# For scale-out (multiple vayl processes), start the postgres profile and set:
# VAYL_DATABASE_URL=postgresql://vayl:CHANGE_ME@postgres:5432/vayl
# POSTGRES_PASSWORD=CHANGE_ME        # must match the password in VAYL_DATABASE_URL
# NEO4J_PASSWORD=CHANGE_ME           # REQUIRED if you enable the graph (VAYL_GRAPH=1); no default

# ─────────────────────────────────────────────────────────────────────────────
# 3) Key custody  (default: file — keys auto-generated on the volume)
# For production, use HashiCorp Vault (master key never leaves Vault). Values: file | vault.
# VAYL_KMS=vault
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=REPLACE_ME            # required when VAYL_KMS=vault
# VAYL_DECRYPT_CACHE=off            # don't cache decrypted data between calls (slower; less in memory)

# ─────────────────────────────────────────────────────────────────────────────
# 4) Enterprise license  (optional; omit → Community edition, capped seats)
# VAYL_VENDOR_PUBKEY=<vendor public key hex, from the vendor>
# VAYL_LICENSE=vayl_lic_....

# ─────────────────────────────────────────────────────────────────────────────
# 5) SSO / OIDC  (optional; requires an Enterprise license)
# VAYL_OIDC_ISSUER=https://your-idp/oauth2/default
# VAYL_OIDC_AUDIENCE=vayl
# VAYL_OIDC_JWKS_URL=https://your-idp/oauth2/v1/keys

# ─────────────────────────────────────────────────────────────────────────────
# 6) Logging  (to stderr; default WARNING)
# VAYL_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
# VAYL_LOG_FORMAT=json               # text (default) | json — one object per line, for log shippers
