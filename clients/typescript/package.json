{
  "name": "vayl",
  "version": "0.1.0",
  "description": "The reconciling memory layer for AI agents — TypeScript client for the Vayl MCP server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vercel": {
      "types": "./dist/integrations/vercel.d.ts",
      "import": "./dist/integrations/vercel.js"
    },
    "./mastra": {
      "types": "./dist/integrations/mastra.d.ts",
      "import": "./dist/integrations/mastra.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependencies": {
    "ai": ">=7",
    "@mastra/core": ">=1",
    "zod": ">=3.25.76"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true },
    "@mastra/core": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "ai": "^7.0.0",
    "@mastra/core": "^1.0.0",
    "zod": "^4.0.0"
  },
  "keywords": ["mcp", "memory", "agents", "llm", "vayl", "model-context-protocol"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vayl-dev/vayl.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://vayl.gitbook.io/vayl-docs"
}
